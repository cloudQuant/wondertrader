+/// 卡9（9a=A+C、9b=A）/ 迭代02 Local 宿主合同: WtLocalExecuter 只有在协调 quiesce
+/// 发布完成后才能析构, 否则 ~WtLocalExecuter 以 std::terminate fail-stop.
+/// 本 lane 按值持有宿主, 因此用不拥有所有权的 manager 条目驱动同一套 quiesce.
+bool quiesceBorrowedLocal(WtLocalExecuter& executer)
+{
+    WtExecuterMgr manager;
+    manager.add_executer(ExecCmdPtr(&executer, [](IExecCommand*) {}));
+    WtExecQuiesceCoordinator coordinator({ &manager });
+    return coordinator.quiesce_all() && coordinator.is_complete() && manager.wait_quiesced();
+}
+
+/// 栈上宿主的作用域守卫: 必须声明在宿主之后, 以便先于宿主析构
+class LocalQuiesceScope : private boost::noncopyable
+{
+public:
+    explicit LocalQuiesceScope(WtLocalExecuter& executer) : _executer(executer) {}
+    ~LocalQuiesceScope()
+    {
+        if (!quiesceBorrowedLocal(_executer))
+        {
+            ADD_FAILURE() << "local executer quiesce did not complete";
+            std::abort();
+        }
+    }
+
+private:
+    WtLocalExecuter& _executer;
 };
 
