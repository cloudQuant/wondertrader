+TEST(T3_006_TraderCTPMini, init_rejects_flowdir_only_configuration)
+{
+	R61MiniProbe probe;
+	R61MiniSink sink;
+	probe.registerSpi(&sink);
+	WTSVariant* cfg = WTSVariant::createObject();
+	cfg->append("flowdir", "r61miniflow_only");
+	EXPECT_FALSE(probe.init(cfg));
+	EXPECT_FALSE(probe.creatorReady());
+	EXPECT_FALSE(probe.moduleLoaded());
+	EXPECT_TRUE(probe.workerNull());
+	EXPECT_EQ(nullptr, probe.api());
+	EXPECT_TRUE(sink.hasLog("front"));
+	cfg->release();
+}
