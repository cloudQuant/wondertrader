+namespace
+{
+	// I03-NEW-133: per-instance settlement query dates (same meaning as TraderCTP's
+	// m_uSettleDate/m_uSettleQryDate). TraderCTPOpt.h is held by another work package,
+	// so the state lives here; entries are dropped when a query ends and on destruction.
+	struct SettleQueryDates
+	{
+		uint32_t rowDate = 0;	// date of the latest cached row
+		uint32_t qryDate = 0;	// date of the outstanding request, 0 when none
+	};
+
+	std::mutex& settleDatesMutex()
+	{
+		static std::mutex* m = new std::mutex();	// never destroyed: usable during exit
+		return *m;
+	}
+
+	std::unordered_map<const void*, SettleQueryDates>& settleDatesTable()
+	{
+		static auto* t = new std::unordered_map<const void*, SettleQueryDates>();
+		return *t;
+	}
+
+	void settleBegin(const void* owner, uint32_t uDate)
+	{
+		std::lock_guard<std::mutex> lock(settleDatesMutex());
+		SettleQueryDates& d = settleDatesTable()[owner];
+		d.rowDate = 0;
+		d.qryDate = uDate;
+	}
+
+	void settleRow(const void* owner, uint32_t rowDate)
+	{
+		if (rowDate == 0)
+			return;
+		std::lock_guard<std::mutex> lock(settleDatesMutex());
+		settleDatesTable()[owner].rowDate = rowDate;
+	}
+
+	SettleQueryDates settleEnd(const void* owner)
+	{
+		std::lock_guard<std::mutex> lock(settleDatesMutex());
+		auto& table = settleDatesTable();
+		auto it = table.find(owner);
+		if (it == table.end())
+			return SettleQueryDates();
+		SettleQueryDates d = it->second;
+		table.erase(it);
+		return d;
+	}
+}
