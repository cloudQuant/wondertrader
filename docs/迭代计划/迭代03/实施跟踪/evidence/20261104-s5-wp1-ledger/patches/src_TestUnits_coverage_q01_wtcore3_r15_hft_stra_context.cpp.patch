+std::string r15WriteFees(const char* name, const std::string& json)
+{
+    const std::filesystem::path path = std::filesystem::path(WtHelper::getBaseDir()) / name;
+    std::ofstream out(path);
+    out << json;
+    return path.string();
+}
+}
