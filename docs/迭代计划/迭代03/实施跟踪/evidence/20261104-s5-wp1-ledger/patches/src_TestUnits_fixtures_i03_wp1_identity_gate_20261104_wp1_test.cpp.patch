+    EXPECT_DOUBLE_EQ(3.0, adapter.getUndoneQty(kStdCode)) << "one fill seen by both streams counts once";
+    pushTrade(adapter, id_, ids[0], 1, "TOT2");						// a newer fill, trade stream first
+    EXPECT_DOUBLE_EQ(2.0, adapter.getUndoneQty(kStdCode));
+    pushOrder(adapter, id_, ids[0], WOS_PartTraded_Queuing, 5, 3);	// order stream catches up
+    EXPECT_DOUBLE_EQ(2.0, adapter.getUndoneQty(kStdCode));
+    pushOrder(adapter, id_, ids[0], WOS_PartTraded_Queuing, 5, 4);	// order stream leads again
+    EXPECT_DOUBLE_EQ(1.0, adapter.getUndoneQty(kStdCode));
+    pushTrade(adapter, id_, ids[0], 1, "TOT3");
+    EXPECT_DOUBLE_EQ(1.0, adapter.getUndoneQty(kStdCode));
+    pushOrder(adapter, id_, ids[0], WOS_AllTraded, 5, 5);
+    EXPECT_DOUBLE_EQ(0.0, adapter.getUndoneQty(kStdCode));
+    pushTrade(adapter, id_, ids[0], 1, "TOT4");						// late trade after terminal
+    EXPECT_DOUBLE_EQ(0.0, adapter.getUndoneQty(kStdCode));
+}
