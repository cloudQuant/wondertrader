+// (2) Pruning terminal tombstones beyond the limit erases from the dense
+// ledger (swap-and-pop), which moves another entry: the rejection being
+// processed must not read its owner/code through a stale iterator.
+TEST_F(Wp1Test, TombstonePruneDuringRejectionKeepsTheRejectedOrdersIdentity)
+{
+    TraderAdapter adapter;
+    build(adapter, &pm_);
+    ASSERT_TRUE(adapter.configureOwnerRoutingCapabilities(allCaps()));
+    p11fix::RecordingSink a;
+    ASSERT_TRUE(adapter.declareOwnerSink(&a, "exec:a"));
+    adapter.addSink(&a);
+    adapter.removeSink(&sink_);	// keep 65536 reports out of the recording sink
+    const uint32_t first = 3000000;
+    for (uint32_t i = 0; i < 65536; ++i)
+        pushOrder(adapter, id_, first + i, WOS_Canceled, 1, 0);	// fill the tombstone window
+    OrderIDs ia = adapter.buyAsOwner("exec:a", true, kStdCode, 7000, 2, 0, false);
+    ASSERT_EQ(1u, ia.size());	// newest ledger entry (last in the dense storage)
+    WTSEntrust* e = WTSEntrust::create(kRawCode, 2, 7000, kExchg);
+    e->setContractInfo(ct_);
+    e->setDirection(WDT_LONG);
+    e->setOffsetType(WOT_OPEN);
+    e->setUserTag(tagFor(id_, ia[0]).c_str());
+    WTSError* err = WTSError::create(WEC_ORDERINSERT, "rejected");
+    adapter.onRspEntrust(e, err);	// its tombstone prunes the oldest one
+    err->release();
+    e->release();
+    size_t failures = 0;
+    for (const auto& rec : a.entrusts_)
+        failures += (!rec.ok && rec.localid == ia[0]) ? 1 : 0;
+    EXPECT_EQ(1u, failures) << "the rejection reaches the order's owner";
+    EXPECT_DOUBLE_EQ(0.0, adapter.getUndoneQtyForOwner(kStdCode, "exec:a"));
+    EXPECT_EQ(TraderAdapter::OrderLedgerState::Terminal, adapter.orderLedger(ia[0]).state);
+    EXPECT_FALSE(adapter.orderLedger(first).found) << "oldest tombstone pruned";
+    adapter.removeSink(&a);
+}
+#endif
