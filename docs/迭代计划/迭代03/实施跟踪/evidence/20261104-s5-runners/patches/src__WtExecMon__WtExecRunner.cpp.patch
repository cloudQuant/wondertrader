+// Card 8b=A (BUG-R134-003/WSN06-001): pure validation of the complete executer
+// list, mirroring WtRunner's runner-level preflight for this runner's kinds
+// (local/diff/dist). It only reads the variant tree, so an invalid entry
+// anywhere in the list is rejected before factories load or any executer is
+// constructed and published.
+// I03-NEW-045 class (card 9a): parser owners without callback-drain proof are
+// retained until process exit; they are moved here and never destroyed, so a
+// late provider callback cannot reach a freed adapter.
+void retainParserOwnersUntilProcessExit(std::vector<ParserAdapterPtr>& owners)
+{
+	static std::mutex* retainedMutex = new std::mutex();
+	static std::vector<ParserAdapterPtr>* retained = new std::vector<ParserAdapterPtr>();
+	std::lock_guard<std::mutex> lock(*retainedMutex);
+	for (ParserAdapterPtr& owner : owners)
+	{
+		if (owner)
+			retained->push_back(owner);
+	}
+	owners.clear();
 }
 
+bool validateExecRunnerEntries(WTSVariant* list, std::string& error)
+{
+	if (list == NULL || list->type() != WTSVariant::VT_Array)
+	{
+		error = "executers must be an array";
+		return false;
+	}
+	std::set<std::string> ids;
+	for (uint32_t idx = 0; idx < list->size(); idx++)
+	{
+		WTSVariant* item = list->get(idx);
+		const std::string where = "executers[" + std::to_string(idx) + "]";
+		if (item == NULL || item->type() != WTSVariant::VT_Object)
+		{
+			error = where + " must be an object";
+			return false;
+		}
+		if (!item->getBoolean("active"))
+			continue;
+		const std::string id = item->getCString("id");
+		if (id.empty())
+		{
+			error = where + ".id must not be empty";
+			return false;
+		}
+		if (!ids.insert(id).second)
+		{
+			error = where + ": duplicate executer id " + id;
+			return false;
+		}
+		std::string kind = item->getCString("name");
+		if (kind.empty())
+			kind = "local";
+		std::string itemError;
+		bool valid = true;
+		if (kind == "local")
+			valid = WtLocalExecuter::validateConfig(item, itemError);
+		else if (kind == "diff")
+			valid = WtDiffExecuter::validateConfig(item, itemError);
+		else if (kind != "dist")
+		{
+			error = where + " (" + id + "): unknown executer kind " + kind;
+			return false;
+		}
+		if (!valid)
+		{
+			error = where + " (" + id + "): " + itemError;
+			return false;
+		}
+	}
+	return true;
+}
+}
