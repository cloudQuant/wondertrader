+                g_fail_next_csv_read_close_for_test = false;
+                closed = false;
+            }
+#endif
+            if (!closed)
+                throw std::runtime_error("Failed to close input file");
+            content.swap(input);
+            return true;
+        }
+        catch (const std::exception& e)
+        {
+            if (cbLogger)
+                cbLogger(fmtutil::format(u8"读取数据文件{}失败: {}", path.c_str(), e.what()));
