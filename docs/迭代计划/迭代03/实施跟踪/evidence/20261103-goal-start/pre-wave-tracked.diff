+	EXPECT_EQ(unit._tick_time_high_water, 99991231220000000ull);
+	EXPECT_TRUE(ctx.buys.empty());
+	EXPECT_TRUE(ctx.sells.empty());
+	EXPECT_TRUE(ctx.hasLog("previous session-adjusted date cannot be verified"));
+	ctx.comm->release();
+}
