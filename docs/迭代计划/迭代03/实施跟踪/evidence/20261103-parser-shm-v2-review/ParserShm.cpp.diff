 ParserShm::~ParserShm()
 {
+	if (!_v2_joined.load(std::memory_order_acquire)) (void)shutdownLegacy();
+}
+
+ParserShm::ApiGuard::ApiGuard(ParserShm* parser, bool allowClosed) noexcept
+	: _parser(parser), _frame{parser, NULL}, _entered(false)
+{
+	uint64_t state = parser->_api_state.load(std::memory_order_acquire);
+	for (;;) {
+		if (((state & API_CLOSED) && (!allowClosed || (state & API_V2_STOP))) ||
+			(state & API_COUNT_MASK) == API_COUNT_MASK) return;
+		if (parser->_api_state.compare_exchange_weak(state, state + 1, std::memory_order_acq_rel)) break;
+	}
+	_frame.previous = _api_stack_top; _api_stack_top = &_frame; _entered = true;
+}
+ParserShm::ApiGuard::~ApiGuard()
+{
+	if (!_entered) return;
+	_api_stack_top = _frame.previous;
+	_parser->_api_state.fetch_sub(1, std::memory_order_release);
+}
+bool ParserShm::isApiThread() const noexcept
+{
+	for (ApiFrame* frame = _api_stack_top; frame; frame = frame->previous) if (frame->parser == this) return true;
+	return false;
+}
+bool ParserShm::isCallbackThread() const noexcept
+{
+	for (CallbackFrame* frame = _callback_stack_top; frame; frame = frame->previous) if (frame->parser == this) return true;
+	return false;
+}
+void ParserShm::sleepInterruptibly(uint64_t micros) const
+{
+	while (micros && !_stopped.load(std::memory_order_acquire)) {
+		const uint64_t part = micros > 10000 ? 10000 : micros;
+		std::this_thread::sleep_for(std::chrono::microseconds(part)); micros -= part;
+	}
+}
+WtParserLifecycleV2Status ParserShm::requestStopV2() noexcept
+{
+	static_assert(std::atomic<uint64_t>::is_always_lock_free && std::atomic<bool>::is_always_lock_free,
+		"ParserShm V2 stop requires lock-free atomic operations");
+	_api_state.fetch_or(API_CLOSED | API_V2_STOP, std::memory_order_acq_rel);
+	_v2_stop.store(true, std::memory_order_release);
+	_stopped.store(true, std::memory_order_release);
+	return WT_PARSER_LIFECYCLE_V2_OK;
+}
+WtParserLifecycleV2Status ParserShm::canWaitV2() const noexcept
+{
+	return g_current_shm_worker == this || isCallbackThread() || isApiThread() ?
+		WT_PARSER_LIFECYCLE_V2_WOULD_DEADLOCK : WT_PARSER_LIFECYCLE_V2_OK;
+}
+WtParserLifecycleV2Status ParserShm::waitDrainedV2(uint32_t timeoutMs) noexcept
+{
+	try {
+		if (canWaitV2() != WT_PARSER_LIFECYCLE_V2_OK) return WT_PARSER_LIFECYCLE_V2_WOULD_DEADLOCK;
+		if (!_v2_stop.load(std::memory_order_acquire)) return WT_PARSER_LIFECYCLE_V2_INVALID_ARGUMENT;
+		const auto start = std::chrono::steady_clock::now();
+		do {
+			if (_worker_failed.load(std::memory_order_acquire)) return WT_PARSER_LIFECYCLE_V2_ERROR;
+			if ((_api_state.load(std::memory_order_acquire) & API_COUNT_MASK) == 0) {
+				bool exited = !_worker_created.load(std::memory_order_acquire);
+				if (!exited && _exit_future.wait_for(std::chrono::milliseconds(0)) == std::future_status::ready) {
+					if (!_exit_future.get()) return WT_PARSER_LIFECYCLE_V2_ERROR;
+					exited = true;
+				}
+				if (exited) {
+					std::unique_lock<std::recursive_mutex> lock(_state_mutex, std::try_to_lock);
+					if (lock.owns_lock()) {
+						_sink = NULL; _bd_mgr = NULL; _connected.store(false, std::memory_order_release);
+						_v2_drained.store(true, std::memory_order_release);
+						return WT_PARSER_LIFECYCLE_V2_DRAINED;
+					}
+				}
+			}
+			if (!timeoutMs) break;
+			std::this_thread::sleep_for(std::chrono::milliseconds(1));
+		} while (timeoutMs == UINT32_MAX || std::chrono::steady_clock::now() - start < std::chrono::milliseconds(timeoutMs));
+		return WT_PARSER_LIFECYCLE_V2_PENDING;
+	} catch (...) { return WT_PARSER_LIFECYCLE_V2_ERROR; }
+}
+bool ParserShm::prepareDestroyV2() noexcept
+{
+	if (!_v2_drained.load(std::memory_order_acquire) || canWaitV2() != WT_PARSER_LIFECYCLE_V2_OK) return false;
+	try {
+		std::unique_lock<std::mutex> lock(_lifecycle_mutex, std::try_to_lock);
+		if (!lock.owns_lock()) return false;
+		if (_thrd_parser && _thrd_parser->joinable()) _thrd_parser->join();
+		_thrd_parser.reset(); _queue = NULL; _mapfile.reset();
+		_v2_joined.store(true, std::memory_order_release); return true;
+	} catch (...) { return false; }
 }
 
