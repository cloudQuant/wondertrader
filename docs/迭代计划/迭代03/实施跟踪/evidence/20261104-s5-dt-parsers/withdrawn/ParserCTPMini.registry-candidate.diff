 #include <limits>
 #include <system_error>
 #include <vector>
+#include <set>
 namespace fs = std::filesystem;
 
+namespace
+{
+	// I03-NEW-003: a vendor module whose load ended without a usable API
+	// (missing creator symbol or null creator result) stays resident with an
+	// unknown vendor state. Record it process-wide so that no other parser
+	// instance loads and re-enters the same module, by path or by handle (alias).
+	// The registry mutex also serializes the check, load and creation, so two
+	// instances cannot race past the check for the same module.
+	std::mutex& quarantinedModuleMutex()
+	{
+		static std::mutex* m = new std::mutex();
+		return *m;
+	}
+	std::set<std::string>& quarantinedModulePaths()
+	{
+		static std::set<std::string>* paths = new std::set<std::string>();
+		return *paths;
+	}
+	std::set<DllHandle>& quarantinedModuleHandles()
+	{
+		static std::set<DllHandle>* handles = new std::set<DllHandle>();
+		return *handles;
+	}
+	std::string moduleKey(const std::string& path)
+	{
+		std::error_code ec;
+		fs::path canonical = fs::weakly_canonical(fs::path(path), ec);
+		return ec ? fs::path(path).lexically_normal().string() : canonical.string();
+	}
+}
