+void CTraderSpi::AppendFeeQuery(const QueryTask& task)
+{
+	{
+		std::lock_guard<std::mutex> lock(_mtx);
+		if (_stopped || _fee_finish_claimed)
+		{
+			_fee_response_failed.store(true, std::memory_order_release);
+			return;
+		}
+		++_fee_queued;
+		_queries.emplace(task);
+		if (!_worker)
+			_worker.reset(new boost::thread([this]() { RunQueryWorker(); }));
+	}
+	_query_ready.notify_one();
+}
+
+int CTraderSpi::BeginFeeQuery(FeeQueryKind kind, const Contract* contract)
+{
+	std::lock_guard<std::mutex> lock(_mtx);
+	if (kind != FeeQueryKind::Instrument && _fee_queued > 0) --_fee_queued;
+	if (_stopped || _fee_finish_claimed || iRequestID == INT_MAX)
+	{
+		_fee_response_failed.store(true, std::memory_order_release);
+		if (kind == FeeQueryKind::Instrument) _fee_batch_sealed = true;
+		return 0;
+	}
+	const int requestId = ++iRequestID;
+#ifndef WT_T26_QUERY_TIMEOUT_MS
+#define WT_T26_QUERY_TIMEOUT_MS 60000
+#endif
+	FeeQueryState state{kind, false, false,
+		std::chrono::steady_clock::now() + std::chrono::milliseconds(WT_T26_QUERY_TIMEOUT_MS)};
+	if (contract)
+	{
+		state.code = contract->m_strCode;
+		state.altcode = contract->m_strAltCode;
+		state.product = contract->m_strProduct;
+		state.exchange = contract->m_strExchg;
+	}
+	_fee_requests.emplace(requestId, std::move(state));
+	return requestId;
+}
+
+bool CTraderSpi::AcceptFeeCallback(int requestId, FeeQueryKind kind, bool responseError)
+{
+	std::lock_guard<std::mutex> lock(_mtx);
+	const auto it = _fee_requests.find(requestId);
+	if (_fee_batch_active && !_fee_finish_claimed && it != _fee_requests.end() &&
+		it->second.kind == kind && it->second.terminal && responseError)
+		_fee_response_failed.store(true, std::memory_order_release);
+	return _fee_batch_active && !_fee_finish_claimed && it != _fee_requests.end()
+		&& it->second.kind == kind && !it->second.terminal;
+}
+
+bool CTraderSpi::FeeCallbackIdentityMatches(int requestId, const std::string& code, const std::string& exchange)
+{
+	std::lock_guard<std::mutex> lock(_mtx);
+	const auto it = _fee_requests.find(requestId);
+	if (it == _fee_requests.end() || code.empty()) return false;
+	const FeeQueryState& state = it->second;
+	return (exchange.empty() || exchange == state.exchange) &&
+		(code == state.code || (!state.altcode.empty() && code == state.altcode) ||
+		 (state.kind == FeeQueryKind::Commission && code == state.product));
+}
+
+bool CTraderSpi::RememberFeeOrigin(int requestId, std::map<std::string, std::string>& origins, const std::string& code)
+{
+	std::lock_guard<std::mutex> lock(_mtx);
+	const auto it = _fee_requests.find(requestId);
+	if (it == _fee_requests.end()) return false;
+	const auto entry = origins.emplace(code, it->second.exchange);
+	return entry.second || entry.first->second == it->second.exchange;
+}
+
+void CTraderSpi::FinishFeeCallback(int requestId, bool last)
+{
+	if (!last) return;
+	std::lock_guard<std::mutex> lock(_mtx);
+	auto it = _fee_requests.find(requestId);
+	if (it != _fee_requests.end()) it->second.terminal = true;
+}
+
+void CTraderSpi::FinishFeeSubmission(int requestId, int result)
+{
+	{
+		std::lock_guard<std::mutex> lock(_mtx);
+		auto it = _fee_requests.find(requestId);
+		if (it == _fee_requests.end()) return;
+		it->second.callReturned = true;
+		if (result != 0)
+		{
+			_fee_response_failed.store(true, std::memory_order_release);
+			it->second.terminal = true;
+			if (it->second.kind == FeeQueryKind::Instrument) _fee_batch_sealed = true;
+		}
+	}
+	FinishFeeBatchIfReady();
+}
+
+bool CTraderSpi::FeeQueryExpiredLocked() const
+{
+	const auto now = std::chrono::steady_clock::now();
+	for (const auto& request : _fee_requests)
+		if ((!request.second.terminal || !request.second.callReturned) && now >= request.second.deadline) return true;
+	return false;
+}
+
+void CTraderSpi::RunFeeWatchdog()
+{
+	std::unique_lock<std::mutex> lock(_mtx);
+	while (!_stopped && !_fee_finish_claimed)
+	{
+		_fee_watchdog_ready.wait_for(lock, std::chrono::milliseconds(100));
+		if (_stopped || _fee_finish_claimed) return;
+		if (FeeQueryExpiredLocked())
+		{
+			_fee_finish_claimed = true;
+			lock.unlock();
+			std::cerr << "--->>> CTP fee query timed out" << std::endl;
+			exit(EXIT_FAILURE);
+		}
+	}
+}
+
+void CTraderSpi::FinishFeeBatchIfReady()
+{
+	std::shared_ptr<boost::thread> worker;
+	std::shared_ptr<boost::thread> watchdog;
+	{
+		std::lock_guard<std::mutex> lock(_mtx);
+		if (!_fee_batch_active || !_fee_batch_sealed || _fee_finish_claimed || _fee_queued != 0)
+			return;
+		for (const auto& request : _fee_requests)
+			if (!request.second.terminal || !request.second.callReturned) return;
+		_fee_finish_claimed = true;
+		_stopped = true;
+		worker = _worker;
+		watchdog = _fee_watchdog;
+	}
+	_query_ready.notify_all();
+	_fee_watchdog_ready.notify_all();
+	// The final terminal callback can run on the query worker itself. Drain the
+	// other owned threads; that worker cannot join itself and exits the process.
+	if (watchdog && watchdog->joinable() && watchdog->get_id() != boost::this_thread::get_id()) watchdog->join();
+	if (worker && worker->joinable() && worker->get_id() != boost::this_thread::get_id()) worker->join();
+	if (_fee_response_failed.load(std::memory_order_acquire)) exit(EXIT_FAILURE);
+	DumpToJson();
+	exit(DumpFees() ? EXIT_SUCCESS : EXIT_FAILURE);
 }
 
