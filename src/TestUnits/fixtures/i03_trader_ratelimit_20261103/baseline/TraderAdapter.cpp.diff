+bool TraderAdapter::submitSplit(OrderIDs& ids, const char* stdCode, bool isBuy, double qty,
+	const std::function<uint32_t()>& submit)
+{
+	const double signedQty = isBuy ? qty : -qty;
+	// Reserve before the provider call: a synchronous rejection report then
+	// finds a non-zero undone quantity and consumes exactly this split.
+	updateUndone(stdCode, signedQty, true);
+
+	EntrustOutcome outcome;
+	void* previous = t_entrust_outcome;
+	t_entrust_outcome = &outcome;
+	uint32_t localid = UINT_MAX;
+	try
+	{
+		localid = submit();
+	}
+	catch (...)
+	{
+		t_entrust_outcome = previous;
+		throw;	// unknown outcome: keep the reservation
+	}
+	t_entrust_outcome = previous;
+
+	if (localid != UINT_MAX)
+	{
+		ids.emplace_back(localid);
+		return true;
+	}
+
+	if (!outcome.ledger_consumed)
+		updateUndone(stdCode, -signedQty, true);
+	return false;
+}
