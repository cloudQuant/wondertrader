+		}
+		return true;
+	}
+
+	uint32_t total_mins = _s_info->getTradingMins();
+	if (_time != UINT_MAX && _last_emit_pos != 0 && _last_emit_pos < total_mins && offTime >= _s_info->getCloseTime(true))
