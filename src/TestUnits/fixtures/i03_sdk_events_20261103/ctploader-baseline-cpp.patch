+void CTraderSpi::NoteFeeRow(int requestId)
+{
+	std::lock_guard<std::mutex> lock(_mtx);
+	auto it = _fee_requests.find(requestId);
+	if (it != _fee_requests.end() && !it->second.terminal) ++it->second.rows;
+}
+
+bool CTraderSpi::FeeResponseEmpty(int requestId)
+{
+	std::lock_guard<std::mutex> lock(_mtx);
+	auto it = _fee_requests.find(requestId);
+	return it != _fee_requests.end() && it->second.rows == 0;
+}
